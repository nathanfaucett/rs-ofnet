{
    "name": "@ofnet/iroh-chain-wasm",
    "version": "0.1.0",
    "description": "Browser (WASM) TypeScript API for ofnet mesh networking",
    "keywords": [
        "ofnet",
        "iroh",
        "wasm",
        "browser",
        "mesh",
        "p2p"
    ],
    "author": "Nathan Faucett <nathanfaucett@gmail.com>",
    "license": "MIT OR Apache-2.0",
    "type": "module",
    "module": "esm",
    "main": "esm",
    "types": "types",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./esm/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "esm",
        "types",
        "pkg"
    ],
    "scripts": {
        "build:wasm": "wasm-pack build --target web --out-dir pkg --release",
        "build:esm": "tsc -p tsconfig.json",
        "build": "pnpm run build:wasm && pnpm run build:esm",
        "clean": "rm -rf esm types pkg tsconfig.tsbuildinfo",
        "test": "vitest run",
        "test:wasm": "wasm-pack test --headless --chrome",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "format": "biome format .",
        "format:fix": "biome format --write .",
        "prepublishOnly": "pnpm run build"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.3",
        "typescript": "^5.9.3",
        "vitest": "^4.0.0",
        "wasm-pack": "^0.15.0"
    }
}
